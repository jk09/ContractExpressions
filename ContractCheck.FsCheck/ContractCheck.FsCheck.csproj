<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>ContractCheck.FsCheck</PackageId>
    <Version>0.1.0</Version>
    <Authors>jk09</Authors>
    <Description>FsCheck property-based testing for ContractCheck: random inputs are run through Dbc.Make proxies, inputs rejected by preconditions are discarded, and postcondition or invariant violations fail the property.</Description>
    <PackageTags>design-by-contract;dbc;fscheck;property-based-testing;contracts</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/jk09/ContractExpressions</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FsCheck" Version="3.3.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ContractCheck\ContractCheck.csproj" />
  </ItemGroup>

</Project>
