<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>ContractCheck</PackageId>
    <Version>0.1.0</Version>
    <Authors>jk09</Authors>
    <Description>Runtime Design-by-Contract for .NET interfaces: preconditions, postconditions and invariants written with System.Diagnostics.Contracts and enforced by a DispatchProxy.</Description>
    <PackageTags>design-by-contract;dbc;contracts;code-contracts;preconditions;postconditions;invariants</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/jk09/ContractExpressions</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <InternalsVisibleTo Include="ContractCheck.Tests" />
  </ItemGroup>

  <!-- The analyzer and its code fix ship inside this package (analyzers/dotnet/cs); the references only order the builds. -->
  <ItemGroup>
    <ProjectReference Include="..\ContractCheck.Analyzers\ContractCheck.Analyzers.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\ContractCheck.CodeFixes\ContractCheck.CodeFixes.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="..\ContractCheck.Analyzers\bin\$(Configuration)\netstandard2.0\ContractCheck.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="..\ContractCheck.CodeFixes\bin\$(Configuration)\netstandard2.0\ContractCheck.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
